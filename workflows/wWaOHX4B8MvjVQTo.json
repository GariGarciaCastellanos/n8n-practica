          },
          "conditions": [
            {
              "leftValue": "={{ $json.recordatorio }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "empty"
              }
            },
            {
              "leftValue": "={{ $now.diff(DateTime.fromFormat($json.fecha, 'yyyy-MM-dd HH:mm'), 'minutes').minutes > $('Configuración').item.json.umbral_minutos }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        }
      }
    },
