  "name": "Facturas por correo",
  "description": "Recibe facturas en el alias +facturas, las manda al extractor y las guarda en la hoja facturas-practica según el estado devuelto.",
  "active": true,
  "isArchived": false,
  "nodes": [
    {
      "parameters": {
        "jsCode": "const salida = [];\nfor (const item of $input.all()) {\n  const mensajeId = item.json.id;\n  const binaryKeys = Object.keys(item.binary || {});\n  for (const key of binaryKeys) {\n    const meta = item.binary[key];\n    salida.push({\n      json: {\n        nombre_archivo: meta.fileName,\n        tipo_mime: meta.mimeType,\n        mensaje_id: mensajeId,\n      },\n      binary: { archivo: meta },\n    });\n  }\n}\nreturn salida;"
      },
